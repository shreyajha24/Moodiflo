# ===============================================
# Backend Environment Variables (Moodify)
# ===============================================

# Database Connection (Required in production)
DB_URL=jdbc:mysql://localhost:3306/moodify?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_secure_database_password

# JWT Security (Required - minimum 256-bit / 32-character secret)
JWT_SECRET=your_minimum_32_character_long_secure_jwt_secret_key!
JWT_EXPIRATION=86400000

# CORS Allowed Origins (Comma-separated list of deployed frontend URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app

# JPA / Hibernate Schema Mode (update, validate, none)
DDL_AUTO=update
