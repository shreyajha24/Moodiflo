# ===============================================
# Backend Environment Variables (Moodify)
# ===============================================

# Database Connection (Required in production)
DB_URL=jdbc:mysql://localhost:3306/moodify?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_secure_database_password

# JWT Security (Required - minimum 256-bit / 32-character secret)
JWT_SECRET=your_minimum_32_character_long_secure_jwt_secret_key!
JWT_EXPIRATION=86400000

# CORS Allowed Origins (Comma-separated list of deployed frontend URLs)
ALLOWED_ORIGINS=https://moodiflo.onrender.com

# JPA / Hibernate Schema Mode (update, validate, none)
DDL_AUTO=update

# Spotify OAuth (create these in the Spotify Developer Dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=https://moodiflo-backend.onrender.com/api/spotify/callback
FRONTEND_URL=https://moodiflo.onrender.com
DEMO_MODE=false
PURGE_LEGACY_DEMO_DATA=false

# Optional translation provider endpoint (server-side only)
TRANSLATION_URL=https://api.mymemory.translated.net/get
LASTFM_API_KEY=
LASTFM_BASE_URL=https://ws.audioscrobbler.com/2.0/
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2/
MUSICBRAINZ_USER_AGENT=Moodiflo/1.0 (contact@example.com)
DISCOVERY_EXTERNAL_PROVIDERS_ENABLED=true
MOOD_DISCOVERY_ENABLED=true
SARGAM_EXTERNAL_DISCOVERY_ENABLED=true
GOOGLE_TRANSLATION_ENABLED=false
GOOGLE_TRANSLATE_PROJECT_ID=
GOOGLE_TRANSLATE_LOCATION=global
GOOGLE_TRANSLATE_CREDENTIALS=
# Local: filesystem path to the JSON file. Render: path to the mounted Render Secret File.
# Backward-compatible aliases accepted by the backend:
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
